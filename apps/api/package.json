{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "start:queue-worker": "node ace queue:work --queue=crawler-video-queue,video-to-voice-queue,video-breakdown-queue",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "checkwrite": "biome check --write",
    "db:migrate:run": "node ace migration:run"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#utils/*": "./app/utils/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#guards/*": "./app/guards/*.js",
    "#jobs/*": "./app/jobs/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@biomejs/biome": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/plugin-adonisjs": "catalog:",
    "@japa/runner": "catalog:",
    "@poppinss/ts-exec": "catalog:",
    "@types/ali-oss": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "hot-hook": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "youch": "catalog:"
  },
  "dependencies": {
    "@adonisjs/auth": "catalog:",
    "@adonisjs/core": "catalog:",
    "@adonisjs/cors": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@adonisjs/queue": "catalog:",
    "@adonisjs/redis": "catalog:",
    "@adonisjs/session": "catalog:",
    "@adonisjs/shield": "catalog:",
    "@adonisjs/static": "catalog:",
    "@ai-sdk/alibaba": "catalog:",
    "@ai-sdk/moonshotai": "catalog:",
    "@japa/api-client": "catalog:",
    "@tuyau/core": "catalog:",
    "@vinejs/vine": "catalog:",
    "ai": "catalog:",
    "ali-oss": "catalog:",
    "better-sqlite3": "catalog:",
    "jsonwebtoken": "catalog:",
    "luxon": "catalog:",
    "mysql2": "catalog:",
    "nanoid": "catalog:",
    "reflect-metadata": "catalog:",
    "uuid": "catalog:",
    "zhipu-ai-provider": "catalog:"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
